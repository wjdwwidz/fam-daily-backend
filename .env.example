# PostgreSQL 연결 문자열 (docker-compose 또는 Neon/Supabase 등 클라우드 Postgres)
DATABASE_URL="postgresql://famdaily:famdaily@localhost:5432/famdaily"
# JWT 서명 시크릿 (운영 시 반드시 강력한 값으로 교체)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000

# 카카오 로그인 (카카오 developers 콘솔에서 발급)
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
# 카카오 콘솔에 등록한 Redirect URI 와 정확히 일치해야 함
KAKAO_REDIRECT_URI="http://localhost:3000/api/auth/kakao/callback"
# 콘솔에서 client secret 을 ON 한 경우에만 설정 (아니면 비워둠)
KAKAO_CLIENT_SECRET=""
# 회원 탈퇴 시 카카오 연결 끊기에 쓰는 어드민 키 (콘솔 > 앱 키). 비워두면 연결 끊기만 건너뜀
KAKAO_ADMIN_KEY=""
# 로그인 완료 후 우리 JWT(token 쿼리)를 붙여 리다이렉트할 프론트 주소
FRONTEND_REDIRECT_URL="http://localhost:5173/auth/callback"

# /privacy, /account-deletion 페이지에 표시할 개인정보 보호책임자와 문의 이메일 (비우면 "준비 중")
PRIVACY_OWNER_NAME=""
PRIVACY_CONTACT_EMAIL=""

# 버려진 업로드 청소를 밖에서 깨울 때 쓰는 토큰 (미설정이면 /api/admin/sweep 은 항상 거부)
ADMIN_SWEEP_TOKEN=""
