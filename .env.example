# PostgreSQL 연결 문자열 (docker-compose 또는 Neon/Supabase 등 클라우드 Postgres)
DATABASE_URL="postgresql://famdaily:famdaily@localhost:5432/famdaily"
# JWT 서명 시크릿 (운영 시 반드시 강력한 값으로 교체)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000

# 카카오 로그인 (카카오 developers 콘솔에서 발급)
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
# 카카오 콘솔에 등록한 Redirect URI 와 정확히 일치해야 함
KAKAO_REDIRECT_URI="http://localhost:3000/api/auth/kakao/callback"
# 콘솔에서 client secret 을 ON 한 경우에만 설정 (아니면 비워둠)
KAKAO_CLIENT_SECRET=""
# 회원 탈퇴 시 카카오 연결 끊기에 쓰는 어드민 키 (콘솔 > 앱 키). 비워두면 연결 끊기만 건너뜀
KAKAO_ADMIN_KEY=""
# 로그인 완료 후 우리 JWT(token 쿼리)를 붙여 리다이렉트할 프론트 주소
FRONTEND_REDIRECT_URL="http://localhost:5173/auth/callback"
# 카카오 로그인 후 토큰을 보내도 되는 주소. 앱(famdaily://)과 FRONTEND_REDIRECT_URL 의 도메인은 항상 허용.
# 그 밖의 웹 도메인은 여기에 쉼표로 (예: "https://famdaily.vercel.app")
WEB_REDIRECT_ORIGINS=""
# Expo Go(exp://) 로 개발할 때만 true. 운영에서 켜면 남의 개발 서버 주소로 토큰이 나갈 수 있음
ALLOW_EXPO_GO_REDIRECT=""

# 웹 앱 주소 (예: "https://woorikkiri.vercel.app"). 초대 링크가 {WEB_APP_URL}/join/코드 로 만들어짐.
# 비우면 초대 링크 없이 코드만 공유. 카카오 로그인 허용을 위해 같은 주소를 WEB_REDIRECT_ORIGINS 에도 넣을 것
WEB_APP_URL=""

# /privacy, /account-deletion 페이지에 표시할 개인정보 보호책임자와 문의 이메일 (비우면 "준비 중")
PRIVACY_OWNER_NAME=""
PRIVACY_CONTACT_EMAIL=""

# 버려진 업로드 청소를 밖에서 깨울 때 쓰는 토큰 (미설정이면 /api/admin/sweep 은 항상 거부)
ADMIN_SWEEP_TOKEN=""

# 일상에 붙일 장소 검색 (구글 Places API (New)). 서버에만 둔다 — 앱에 넣으면 남이 꺼내 쓸 수 있다.
# 비우면 장소 검색이 "아직 준비되지 않았어요" 로 응답한다
GOOGLE_MAPS_API_KEY=""
# 장소 검색 하루 한도 (기본 150 — 150×31일이 구글 무료 한도 월 5,000회 아래)
PLACES_DAILY_LIMIT=150

# 홈 '이번 달 우리 가족' 요약에 쓸 LLM. "anthropic"(기본) 또는 "openai". 키는 서버에만 둔다. 키가 비면 요약을 만들지 않는다
LLM_PROVIDER="anthropic"
# Anthropic 키 (sk-ant-…). 비우면 claude-haiku-4-5. 쓸 수 있는 모델 이름은 Anthropic 문서에서 확인
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# OpenAI 키 (sk-proj-…). 비우면 gpt-4.1-mini. 쓸 수 있는 모델 이름은 OpenAI 문서에서 확인
OPENAI_API_KEY=""
OPENAI_MODEL=""
# 로컬 테스트용: true 면 알림 화면의 지난 요약 목록에 진행 중인 이번 달도 넣는다. 배포 환경에는 두지 않는다
SUMMARY_SHOW_CURRENT_MONTH=""
# 하루에 새로 만드는 요약 수 상한 (모든 가족 합계, 기본 50). 기록이 그대로인 가족은 세지 않는다
SUMMARY_DAILY_LIMIT=50
# 비용 추정용 단가 (100만 토큰당 달러). 비우면 공급자 기본값. 모델을 바꾸면 그 모델 가격으로
LLM_INPUT_USD_PER_MTOK=""
LLM_OUTPUT_USD_PER_MTOK=""
